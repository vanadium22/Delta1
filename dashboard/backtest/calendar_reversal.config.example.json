{
  "data": {
    "data_root": "PATH_TO_AUDITED_LOCAL_SNAPSHOT",
    "dataset_id": "YOUR_LOCAL_DATASET",
    "data_version": "YOUR_FROZEN_VERSION",
    "source_id": "YOUR_AUDITED_SOURCE",
    "daily_close_path": "daily_close.parquet",
    "reference_path": "contracts.parquet",
    "days_to_expiry_path": "days_to_expiry.parquet",
    "calendar_path": "calendar.csv",
    "dividend_mode": "ignore",
    "margin_rates": {"IF": 1.0, "IH": 1.0, "IC": 1.0, "IM": 1.0},
    "daily_label_time": "15:00"
  },
  "factor": {
    "name": "calendar_pair_percentile",
    "roots": ["IF", "IH", "IC", "IM"],
    "slots": [0, 1, 2, 3],
    "precision": "1d",
    "workers": 1,
    "parameters": {"window_days": 60, "channels": ["01-02", "02-03"]}
  },
  "cta": {
    "name": "calendar_reversal",
    "input_factor": "calendar_pair_percentile",
    "parameters": {
      "channel": "01-02", "root": "all", "q_open": 0.9,
      "allowed_spread_side": "both",
      "exit_mode": "expiry", "q_close": 0.5, "position_weight": 0.495
    }
  },
  "backtest": {
    "initial_capital": 10000000, "commission_rate": 0.0003,
    "max_capital_usage": 0.99, "minimum_margin_ratio": 0.0001,
    "margin_call_basis": "equity", "mode": "product", "precision": "1d", "workers": 1,
    "weight_mode": "neutral_units", "d0": 0,
    "rebalance_on_change_only": true, "preserve_pair_lots": true, "liquidate_at_end": false,
    "start": "2024-01-01", "end": null
  },
  "factor_input": null,
  "tuning": {
    "grid": {
      "cta.parameters.channel": ["01-02", "02-03"],
      "cta.parameters.exit_mode": ["expiry", "threshold"]
    },
    "max_runs": 4
  }
}

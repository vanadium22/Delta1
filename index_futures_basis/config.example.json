{
  "version": 2,
  "history_months": 12,
  "close_hour": 15,
  "close_minute": 5,
  "wind_python": "",
  "wind_timeout_seconds": 90,
  "wind_mapping_field": "trade_hiscode",
  "wind_expiry_field": "lasttrade_date",
  "data_directory": "data",
  "exports_directory": "exports",
  "auto_sync": true,
  "chart_windows": {
    "series_months": 3,
    "fixed_60_months": [3, 1],
    "fixed_90_months": [3, 1],
    "calendar_months": 3,
    "annual_quantile_months": [3, 6, 12],
    "fixed_60_quantile_months": [3, 6, 12],
    "fixed_90_quantile_months": [3, 6, 12],
    "calendar_quantile_months": [3, 6, 12],
    "cross_quantile_months": [3, 6, 12]
  },
  "report_windows": {
    "series_months": 3,
    "fixed_60_months": [3, 1],
    "fixed_90_months": [3, 1],
    "calendar_months": 3,
    "annual_quantile_months": [3, 6, 12],
    "fixed_60_quantile_months": [3, 6, 12],
    "fixed_90_quantile_months": [3, 6, 12],
    "calendar_quantile_months": [3, 6, 12],
    "cross_quantile_months": [3, 6, 12]
  },
  "dividends": {
    "selection": "latest_snapshot",
    "directories": ["inputs", "input"],
    "pattern": "*基差情况_*.xlsx",
    "sheet": "Sheet1",
    "header_row": 3,
    "layout": "snapshot_continuous",
    "snapshot_date_cell": "B1",
    "code_column": "B",
    "dividend_column": "G"
  }
}

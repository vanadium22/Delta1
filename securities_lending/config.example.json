    "nominal": "可融市值",
    "nominal_limit": "可融市值上限",
    "rate": "参考费率",
    "price": "收盘价",
    "term": "期限",
    "source": "来源"
  },
  "quantity_policy": "minimum",
  "quantity_unit": "股",
  "nominal_unit": "元",
  "numeric_rate_unit": "decimal",
  "wind_enabled": true,
  "wind_python": "",
  "wind_field": "industry_sw",
  "wind_options": "tradeDate={date};industryType=1",
  "industry_label": "申万一级",
  "wind_timeout_seconds": 25

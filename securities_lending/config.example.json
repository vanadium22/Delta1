{
  "schema_version": 2,
  "source_root": "",
  "file_glob": "申万内部券单{date}.xlsx",
  "file_selection": "latest",
  "sheet_name": "库存券单",
  "header_row": null,
  "columns": {
    "code": "证券代码",
    "name": "证券简称",
    "quantity": "可融股数",
